{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-emdash-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site",
			"database_id": "f4e8512f-adb0-4b27-a740-551edfb1a337"
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "wiki-it-sms-media",
		},
	],
	"build": {
		"command": "npm run build"
	},
}